{
  "name": "dsh-plugin-dayflow",
  "version": "0.6.0",
  "description": "Your Dayflow screen timeline as DeepSeek Harness tools, skills, and an optional Web panel: ask what you worked on, how your screen time split up, and draft standups from the timeline the Dayflow Mac app recorded locally.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dayflow",
    "time-tracking",
    "timeline",
    "standup",
    "productivity"
  ],
  "homepage": "https://github.com/tailong-wu/dsh-plugin-dayflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailong-wu/dsh-plugin-dayflow.git"
  },
  "bugs": {
    "url": "https://github.com/tailong-wu/dsh-plugin-dayflow/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "docs",
    "README.md",
    "README.zh.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "prepack": "npm run build",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "demo": "node scripts/demo/render.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-util-values": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2"
  }
}
